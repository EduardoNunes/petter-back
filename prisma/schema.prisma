generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  password     String
  profileImage String?
  loggedBy     String

  userInfo             UserInfo?
  PetterInfo           PetterInfo[]
  Like                 Like[]
  PetterImagesTimeline PetterImagesTimeline[]
}

model UserInfo {
  id           Int    @id @default(autoincrement())
  userId       Int    @unique
  date         String
  gender       String
  phone        String
  cep          String
  neighborhood String
  ddd          String
  locality     String
  publicPlace  String
  uf           String

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PetterInfo {
  id             Int     @id @default(autoincrement())
  petterName     String
  petterKind     String
  petterBreed    String
  petterBirth    String
  profileImage   String  @default("")
  descriptionBio String?
  userId         Int
  user           Users   @relation(fields: [userId], references: [id])

  PetterImages         PetterImages[]         @relation("PetterInfoToPetterImages")
  PetterImagesTimeline PetterImagesTimeline[]
  Like                 Like[]                 @relation("PetterInfoToLike")

  @@map("petter_infos")
}

model PetterImages {
  id          Int        @id @default(autoincrement())
  url         String
  description String?
  petterId    Int
  petter      PetterInfo @relation(fields: [petterId], references: [id], name: "PetterInfoToPetterImages")
  Like        Like[]     @relation("PetterImagesToLike")

  @@map("petter_images")
}

model Like {
  id           Int      @id @default(autoincrement())
  userId       Int
  imageId      Int?
  petterInfoId Int
  timelineId   Int?
  createdAt    DateTime @default(now())

  user       Users                 @relation(fields: [userId], references: [id])
  image      PetterImages?         @relation(fields: [imageId], references: [id], name: "PetterImagesToLike")
  petterInfo PetterInfo            @relation(fields: [petterInfoId], references: [id], name: "PetterInfoToLike")
  timeline   PetterImagesTimeline? @relation(fields: [timelineId], references: [id], name: "PetterImagesTimelineToLike")

  @@index([userId])
  @@index([imageId])
  @@index([petterInfoId])
  @@index([timelineId])
}

model PetterImagesTimeline {
  id          Int    @id @default(autoincrement())
  description String
  url         String

  userId Int
  user   Users @relation(fields: [userId], references: [id])

  petterInfoId Int
  petterInfo   PetterInfo @relation(fields: [petterInfoId], references: [id])
  Like         Like[]     @relation("PetterImagesTimelineToLike")
}
