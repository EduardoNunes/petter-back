generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  password     String
  profileImage String?

  userInfo   UserInfo?
  PetterInfo PetterInfo[]
}

model UserInfo {
  id           Int    @id @default(autoincrement())
  userId       Int    @unique
  date         String
  gender       String
  phone        String
  cep          String
  neighborhood String
  ddd          String
  locality     String
  publicPlace  String
  uf           String

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PetterInfo {
  id          Int    @id @default(autoincrement())
  petterName  String
  petterKind  String
  petterBreed String
  petterBirth String
  userId      Int
  user        Users  @relation(fields: [userId], references: [id])

  PetterImages PetterImages[] @relation("PetterInfoToPetterImages")

  @@map("petter_infos")
}

model PetterImages {
  id          Int        @id @default(autoincrement())
  url         String
  description String?
  petterId    Int
  petter      PetterInfo @relation(fields: [petterId], references: [id], name: "PetterInfoToPetterImages")

  @@map("petter_images")
}
